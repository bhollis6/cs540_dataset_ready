# GitHub personal access token (for PR scraping)
GITHUB_TOKEN=ghp_your_token_here

# --- LLM Judge Provider ---
# Default provider is "claude-code" which uses your local claude CLI (Max plan).
# No API key needed for claude-code.

# Anthropic API key (only needed if using --provider anthropic)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenRouter API key (only needed if using --provider openrouter)
# OPENROUTER_API_KEY=sk-or-your_key_here
